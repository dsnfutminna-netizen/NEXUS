# Keep NEXUS_BACKEND=sqlite for the existing local pilot.
# Hosted releases must set NEXUS_BACKEND=supabase.
NEXUS_BACKEND=supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
NEXUS_SUPPORT_URL=
# Optional confirmed app URL for email confirmation redirects.
NEXUS_APP_URL=
